# Supabase / PostgreSQL Connection String
# Format derived from backend/app/database.py & backend/.env.example:
# Direct: postgresql+psycopg2://postgres:<password>@<host>:5432/postgres
# Pooled (PgBouncer/Supavisor): postgresql+psycopg2://postgres:<password>@<host>:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:<password>@<host>:5432/postgres

# Application Settings
APP_ENV=development
API_V1_PREFIX=/api/v1
PROJECT_NAME="Parcel Intelligence API"

# Security & Authentication (min 32 chars in production)
JWT_SECRET=dev_secret_key_change_in_production_min_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
